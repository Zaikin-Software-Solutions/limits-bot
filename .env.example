# =========== Telegram ===========
# Токен бота из BotFather. НЕ коммитить реальный токен — только в .env (в .gitignore).
BOT_TOKEN=123456789:AA-replace-with-token-from-BotFather

# Куда слать push-уведомления. Число с минусом для супергрупп/каналов,
# положительное — для личного чата. Узнать id: напиши боту и глянь getUpdates.
CHAT_ID=-1000000000000

# Опционально: список Telegram user id (через запятую), которым разрешены
# команды /status, /next. Пусто = отвечать всем в CHAT_ID.
ALLOWED_USER_IDS=

# =========== Источник лимитов ===========
# Эндпоинт лимитов Claude (тот же rotate-proxy, что использует CCR).
LIMITS_API_URL=https://rotate-proxy.rodionov.uk/v1/claude/limits

# Bearer-токен для limits API.
LIMITS_TOKEN=replace-with-limits-bearer-token

# Опционально: мониторить только эти аккаунты (email через запятую).
# Пусто = все credentials[], что вернёт API.
ACCOUNTS_FILTER=

# =========== Источник лимитов Codex (опционально) ===========
# Эндпоинт codex-лимитов (CLIProxyAPI). Пусто = codex не мониторим.
# На ns1 сам себе: http://127.0.0.1:8317/v1/codex/limits
CODEX_API_URL=
# Bearer-токен (api-key из config.yaml CLIProxyAPI).
CODEX_TOKEN=

# Host path to CLIProxyAPI auth files (read-only bind mount in Docker).
# On ns1: /opt/cliproxyapi/auths. Leave default only for local fixtures.
CODEX_AUTH_HOST_DIR=./codex-auth
# For a direct Python run outside Docker, point this to the same directory.
CODEX_AUTH_DIR=

# =========== Health checks ===========
# Real, short completions detect expired OAuth that /models and /limits miss.
CLAUDE_PROBE_MODEL=claude-sonnet-5-5
CODEX_PROBE_MODEL=gpt-6-luna
HEALTH_POLL_INTERVAL_MIN=10
# Warn before the Codex OAuth access token expiry; auto-refresh may renew it.
CODEX_REAUTH_WARN_HOURS=48

# =========== Поведение ===========
# Интервал опроса в минутах.
POLL_INTERVAL_MIN=30

# За сколько часов до обнуления недельного окна слать предупреждение.
WEEKLY_WARN_HOURS=2

# Пороги утилизации (%), при пересечении которых вверх шлём алерт. Через запятую.
THRESHOLDS=80,95

# Порог утилизации платного overflow (extra_usage), %, для алерта.
EXTRA_USAGE_WARN_PCT=80

# Путь к файлу состояния (снапшот прошлого опроса).
STATE_PATH=/data/state.json
